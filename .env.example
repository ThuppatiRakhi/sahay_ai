# SahayAI Environment Configuration

# Application Environment (development, testing, production)
APP_ENV=development
LOG_LEVEL=INFO

# Storage & Database
DATABASE_URL=sqlite:///data/sahay_ai.db
SCHEMES_RAW_PATH=data/schemes/schemes.json
SCHEMES_VERIFIED_PATH=data/schemes/verified_schemes.json

# PII Protection Vault Key (32-byte base64 key; generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
SAHAY_PII_ENCRYPTION_KEY=

# OCR & Vision Configuration
OCR_LANGUAGES=eng+hin
OCR_BACKEND_PREFERENCE=auto # Options: auto, rapidocr, tesseract, paddleocr

# Tesseract OCR Windows Installation Path:
# If using Tesseract on Windows, download installer from: https://github.com/UB-Mannheim/tesseract/wiki
# or install via winget: winget install UB-Mannheim.TesseractOCR
# Default location: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
ENFORCE_IMAGE_QUALITY=true

# Official Government Portal API Configuration
GOV_PORTAL_API_BASE_URL=https://api.myscheme.gov.in
GOV_PORTAL_API_KEY=

# Server-Side Session & Cookie Security Configuration
# Cookie name stored in the browser (HttpOnly)
SESSION_COOKIE_NAME=sahay_session
# Session time-to-live in seconds (default: 86400 = 24 hours)
SESSION_TTL_SECONDS=86400
# Must be true in production to force HTTPS transmission (set false for local HTTP dev)
SESSION_COOKIE_SECURE=false
# SameSite policy for CSRF mitigation (lax, strict, or none)
SESSION_COOKIE_SAMESITE=lax
# Cryptographically random secret key (>= 32 chars); strictly enforced in production
SESSION_SECRET_KEY=

# Text-to-Speech (TTS) Configuration (Phase 2 Multilingual Voice Playback)
# Options: auto (default: uses google_cloud if configured, else free Indic TTS), google_free, google_cloud, mock
TTS_PROVIDER=auto
# Maximum characters per audio synthesis request (default: 1500)
TTS_MAX_CHAR_LIMIT=1500
# Optional Google Cloud TTS Credentials (only needed if TTS_PROVIDER=google_cloud)
# GCP_TTS_API_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=
